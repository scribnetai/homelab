# Copy to .env ON THE VM (never commit a filled .env) and set the
# real address of the NUT server (upsd). No secrets live in this
# file: upsd has no users yet, and PeaNUT's own admin account is
# created in the browser on first open and stored in ./peanut-config.

# The Proxmox host that owns the UPS (runs the NUT driver + upsd).
NUT_HOST=192.0.2.12
NUT_PORT=3493
