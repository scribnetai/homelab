# Copy to .env ON THE VM (never commit a filled .env) and set a real
# DB_PASSWORD. Generate it on the VM or in your password manager; it
# goes into the password manager and NOWHERE else -- not chat, not git.
# Upstream rule: DB_PASSWORD uses only A-Za-z0-9, no specials or spaces.
#
# Docs for all variables: https://docs.immich.app/install/environment-variables

# The photo library itself -- on the VM's dedicated data disk (/data),
# so the library + database are one mount and one backup unit.
UPLOAD_LOCATION=/data/library

# The database files. Local disk only -- network shares are NOT
# supported for the database (upstream). This is the same data disk.
DB_DATA_LOCATION=/data/postgres

TZ=America/New_York

# Pin the exact release at install time (check the releases page);
# a bare major tag floats, which is fine for a first boot and wrong
# for unattended upgrades.
IMMICH_VERSION=v3

DB_PASSWORD=CHANGE-ME-generate-a-random-alphanumeric-password

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
