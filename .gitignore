# Local secrets and throwaway data — never commit.
.env
backups/
*.tgz
*.key
*.pem

# Terraform local values, state, and working dirs — never commit.
*.tfvars
*.tfstate
*.tfstate.*
.terraform/
*.tfplan

# Local-only helm value overlays (filled copies carry real LAN IPs)
# and the pve-exporter config (token value) — never commit.
*.local.yaml
pve-exporter-config.yml
